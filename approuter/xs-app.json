{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "errorPage": [
    {
      "status": [404],
      "file": "/dist/index.html"
    }
  ],
  "routes": [
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": false
    },
    {
      "source": "^/(.*)$",
      "localDir": "dist",
      "authenticationType": "xsuaa"
    }
  ]
}
